            unit:  command:lib#test
  representative:  command:lib
         modules:  command:lib
          target:  command:lib
            task:  test
          origin:  group
            argv:  ["echo", "command test lib"]
      persistent:  false
      depends_on:  command:core#test, command:core#build, command:lib#build

            unit:  command:lib#build
  representative:  command:lib
         modules:  command:lib
          target:  command:lib
