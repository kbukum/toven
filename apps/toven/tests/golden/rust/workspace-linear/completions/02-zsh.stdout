(( $+functions[_toven_commands] )) ||
_toven_commands() {
    local commands; commands=(
'run:Run a task by name (escape hatch for task names that shadow a reserved word)' \
'plan:Preview what a task would run, without executing it (\`run <task> --dry-run\`)' \
'release:Plan, inspect, and publish a release through its lifecycle actions' \
'coverage:Run the coverage task, aggregate the emitted profiles per module, and gate them against the resolved coverage thresholds' \
'explain:Explain what a task would run, optionally filtered to a \`--module\` selection' \
'init:Detect ecosystems and write (or preview) a \`toven.toml\` via the wizard' \
'affected:Project the affected-module set for a task' \
'modules:List discovered modules' \
'list:List discovered modules' \
'ls:List discovered modules' \
'graph:Project the dependency graph (text or dot)' \
'deps:Project the dependency graph (text or dot)' \
'tasks:List the runnable tasks resolved for each ecosystem' \
'doctor:Audit the tools the resolved task graph needs and report which are present or missing' \
'commit-lint:Lint a commit message (or PR title) against the Conventional Commits \`type(scope)!\: description\` grammar Toven'\''s changelog relies on' \
'completions:Print a shell completion script (\`bash\`/\`zsh\`/\`fish\`/\`powershell\`/\`elvish\`)' \
'driver:Out-of-process driver management' \
'federation:Cross-repo federation management' \
'cache:Task-cache maintenance' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'toven commands' commands "$@"
}
(( $+functions[_toven__subcmd__affected_commands] )) ||
_toven__subcmd__affected_commands() {
    local commands; commands=()
    _describe -t commands 'toven affected commands' commands "$@"
}
(( $+functions[_toven__subcmd__cache_commands] )) ||
_toven__subcmd__cache_commands() {
    local commands; commands=(
'stats:Summarize the local cache directory' \
'clean:Remove the local cache directory' \
'path:Print the resolved local cache directory' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'toven cache commands' commands "$@"
}
(( $+functions[_toven__subcmd__cache__subcmd__clean_commands] )) ||
_toven__subcmd__cache__subcmd__clean_commands() {
    local commands; commands=()
    _describe -t commands 'toven cache clean commands' commands "$@"
}
(( $+functions[_toven__subcmd__cache__subcmd__help_commands] )) ||
_toven__subcmd__cache__subcmd__help_commands() {
    local commands; commands=(
'stats:Summarize the local cache directory' \
'clean:Remove the local cache directory' \
'path:Print the resolved local cache directory' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'toven cache help commands' commands "$@"
}
(( $+functions[_toven__subcmd__cache__subcmd__help__subcmd__clean_commands] )) ||
_toven__subcmd__cache__subcmd__help__subcmd__clean_commands() {
    local commands; commands=()
