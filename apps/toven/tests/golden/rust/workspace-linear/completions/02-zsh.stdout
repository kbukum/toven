'coverage:Run the coverage task, aggregate the emitted profiles per module, and gate them against the resolved coverage thresholds' \
'explain:Explain what a task would run, optionally filtered to a \`--module\` selection' \
'init:Detect ecosystems and write (or preview) a \`toven.toml\` via the wizard' \
'affected:Project the affected-module set for a task' \
'modules:List discovered modules' \
'graph:Project the dependency graph (text or dot)' \
'tasks:List the runnable tasks resolved for each ecosystem' \
'doctor:Audit the tools the resolved task graph needs and report which are present or missing' \
'commit-lint:Lint a commit message (or PR title) against the Conventional Commits \`type(scope)!\: description\` grammar Toven'\''s changelog relies on' \
'completions:Print a shell completion script (\`bash\`/\`zsh\`/\`fish\`/\`powershell\`/\`elvish\`)' \
'driver:Out-of-process driver management' \
'federation:Cross-repo federation management' \
'cache:Task-cache maintenance' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'toven help commands' commands "$@"
}
