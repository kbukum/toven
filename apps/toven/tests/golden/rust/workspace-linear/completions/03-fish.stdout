# Print an optspec for argparse to handle cmd's options that are independent of any subcommand.
function __fish_toven_global_optspecs
    string join \n config= output= color= view= dry-run explain fail-fast no-cache refresh timeout= j/jobs= base= merge-base module= workspace= dependents dependencies watch watch-debounce-ms= v/verbose q/quiet no-push patch= minor= major= set-version= pre= offline out-dir= target= binary= download no-run line= function= region= changed-line= enforcement= force= root= non-interactive yes print format= auto-install h/help V/version
end

function __fish_toven_needs_command
    # Figure out if the current invocation already has a command.
    set -l cmd (commandline -opc)
    set -e cmd[1]
    argparse -s (__fish_toven_global_optspecs) -- $cmd 2>/dev/null
    or return
    if set -q argv[1]
        # Also print the command, so this can be used to figure out what it is.
        echo $argv[1]
        return 1
    end
    return 0
end

function __fish_toven_using_subcommand
    set -l cmd (__fish_toven_needs_command)
    test -z "$cmd"
    and return 1
    contains -- $cmd[1] $argv
end

complete -c toven -n "__fish_toven_needs_command" -l config -d 'Path to the `toven.toml` config (otherwise discovered upward from the cwd)' -r -F
complete -c toven -n "__fish_toven_needs_command" -l output -d 'Output format: `human` tables or machine-readable `jsonl` (defaults to the `[toven].report` setting)' -r -f -a "human\t'Human-readable terminal rendering'
jsonl\t'Machine-parseable JSON-lines Event stream'"
complete -c toven -n "__fish_toven_needs_command" -l color -d 'When to colorize human output: `auto` (default), `always`, or `never`. `NO_COLOR` always wins over `always`. Accepted on every command; commands that produce no colorized output simply ignore it' -r -f -a "auto\t'Color only when stderr is a terminal and `NO_COLOR` is unset (default)'
always\t'Force color on (still overridden by `NO_COLOR`)'
never\t'Force color off'"
complete -c toven -n "__fish_toven_needs_command" -l view -d 'How live per-unit output renders while a task runs: `auto` (default), `tiles`, `panes`, or `stream`. Applies only when running tasks (`toven run` / `toven <task>`); overrides the `[toven].view` setting. Redirected, piped, `--output jsonl`, and non-interactive runs always use the linear `stream` shape regardless of this flag' -r -f -a "auto\t'Pick the richest shape the environment supports (default)'
tiles\t'One live, content-sized tile per in-flight unit in a single terminal'
panes\t'One multiplexer pane per unit (opt-in; requires a supported multiplexer)'
stream\t'A single linear stream, log-friendly (each unit flushed as one block)'"
complete -c toven -n "__fish_toven_needs_command" -l timeout -d 'When running tasks only: bound how long any single execution unit may run before it is cooperatively cancelled and reported as a timeout failure (duration string, e.g. `30s`, `5m`)' -r
complete -c toven -n "__fish_toven_needs_command" -s j -l jobs -d 'When running tasks only: cap how many units run concurrently, overriding the `[toven].max_parallel` setting. `--jobs 1` forces strictly serial execution (one unit at a time), which streams each unit\'s output inline as a single continuous log instead of buffered per-unit blocks' -r
complete -c toven -n "__fish_toven_needs_command" -l base -d 'Change-selection commands only: override the diff baseline reference (per-member under a federation; falls back to `[[members]].base_ref` / `[project].base_ref`)' -r
complete -c toven -n "__fish_toven_needs_command" -l module -d 'Execution/affected/explain verbs and bare tasks: activate modules by selector — a bare name (`core`), `ecosystem:name` (`rust:core`), `workspace/name` (`backend/api`), or a glob (`rust:*`, `rskit-*`) — bypassing changed-selection (repeatable)' -r
complete -c toven -n "__fish_toven_needs_command" -l workspace -d 'Execution/affected/explain verbs and bare tasks: activate every module owned by a workspace, by id or glob (`backend`, `rust:contrib`, `backend*`), bypassing changed-selection (repeatable)' -r
