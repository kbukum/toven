            cand --download 'Release verify only: download the declared assets from the hosted release and verify signature + checksum before extraction, instead of verifying the local `dist/` archives'
            cand --no-run 'Release verify only: skip executing the packaged binary; presence, signature, and checksum are still enforced'
            cand --non-interactive 'Init only: answer the wizard non-interactively, accepting every default'
            cand --yes 'Release bump/tag/publish/image only: confirm the real mutation. Kept separate from `--non-interactive` so authorizing a release is always a deliberate flag, never something learned as harmless on `init`'
            cand --print 'Init only: render the `toven.toml` to stdout and write nothing'
            cand --auto-install 'Driver/federation only: provision missing drivers automatically'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'toven;cache;path'= {
            cand --config 'Path to the `toven.toml` config (otherwise discovered upward from the cwd)'
            cand --output 'Output format: `human` tables or machine-readable `jsonl` (defaults to the `[toven].report` setting)'
            cand --color 'When to colorize human output: `auto` (default), `always`, or `never`. `NO_COLOR` always wins over `always`. Accepted on every command; commands that produce no colorized output simply ignore it'
            cand --view 'How live per-unit output renders while a task runs: `auto` (default), `tiles`, `panes`, or `stream`. Applies only when running tasks (`toven run` / `toven <task>`); overrides the `[toven].view` setting. Redirected, piped, `--output jsonl`, and non-interactive runs always use the linear `stream` shape regardless of this flag'
            cand --timeout 'When running tasks only: bound how long any single execution unit may run before it is cooperatively cancelled and reported as a timeout failure (duration string, e.g. `30s`, `5m`)'
            cand -j 'When running tasks only: cap how many units run concurrently, overriding the `[toven].max_parallel` setting. `--jobs 1` forces strictly serial execution (one unit at a time), which streams each unit''s output inline as a single continuous log instead of buffered per-unit blocks'
            cand --jobs 'When running tasks only: cap how many units run concurrently, overriding the `[toven].max_parallel` setting. `--jobs 1` forces strictly serial execution (one unit at a time), which streams each unit''s output inline as a single continuous log instead of buffered per-unit blocks'
            cand --compute-budget 'When running tasks only: cap the CPU parallelism handed to each spawned tool, overriding `[toven].compute_budget`. The engine splits this total budget across the units running concurrently and injects each share as an ecosystem env var (e.g. `GOMAXPROCS`). `auto` sizes it to the host CPUs; `inherit` (or `0`) injects nothing'
            cand --base 'Change-selection commands only: override the diff baseline reference (per-member under a federation; falls back to `[[members]].base_ref` / `[project].base_ref`)'
            cand --module 'Execution/affected/explain verbs and bare tasks: activate modules by selector — a bare name (`core`), `ecosystem:name` (`rust:core`), `workspace/name` (`backend/api`), or a glob (`rust:*`, `rskit-*`) — bypassing changed-selection (repeatable)'
            cand --workspace 'Execution/affected/explain verbs and bare tasks: activate every module owned by a workspace, by id or glob (`backend`, `rust:contrib`, `backend*`), bypassing changed-selection (repeatable)'
            cand --watch-debounce-ms 'Watch only: trailing-edge debounce window, in milliseconds, for coalescing a burst of filesystem events into one rerun (default 200)'
            cand --patch 'Release bump/tag/publish only: force `<module>` to bump at the patch level (repeatable; valued form `--patch=<module>`). Given with no value, bumps every in-scope module at patch, each advancing from its own baseline (repo-wide). Highest precedence with the other level flags and `--set-version`; a module named in two level flags or a level flag plus `--set-version` is a usage error'
            cand --minor 'Release bump/tag/publish only: force `<module>` to bump at the minor level (repeatable; valued form `--minor=<module>`). Given with no value, bumps every in-scope module at minor, each advancing from its own baseline (repo-wide)'
            cand --major 'Release bump/tag/publish only: force `<module>` to bump at the major level (repeatable; valued form `--major=<module>`). Given with no value, bumps every in-scope module at major, each advancing from its own baseline (repo-wide)'
            cand --set-version 'Release bump/tag/publish only: pin `<module>=<x.y.z>` to an explicit target version (repeatable), or a bare `<x.y.z>` to set every in-scope module to that version (lock-step, root included)'
            cand --pre 'Release bump/tag/publish only: cut a prerelease on a configured channel (`rc`/`alpha`/`beta`)'
            cand --out-dir 'Release sbom/depgraphs only: directory to write generated artifacts into (created if absent; defaults to `target/toven/release`)'
            cand --target 'Release package only: the target triple to package (e.g. `x86_64-unknown-linux-gnu`); selects the declared archive asset and the built binary under `target/<triple>/release/`'
            cand --binary 'Release package only: explicit path to the already-built binary to archive; defaults to `target/<triple>/release/<binary>`'
            cand --line 'Coverage only: override the absolute line-coverage floor for this run (percentage, `0..=100`); wins over the `[…coverage].line` config default'
            cand --function 'Coverage only: override the function-coverage floor for this run (percentage; gated only where the ecosystem measures functions)'
            cand --region 'Coverage only: override the region-coverage floor for this run (percentage; gated only where the ecosystem measures regions)'
            cand --changed-line 'Coverage only: override the changed-lines floor for this run (percentage; applied to changed files under a changed selection)'
            cand --enforcement 'Coverage only: override how a below-threshold verdict is enforced (`block` fails the gate; `advisory` reports without failing)'
            cand --force 'Init only: regenerate one `[ecosystems.<id>]` section'
            cand --root 'Init only: project root to onboard against'
            cand --format 'Graph only: dependency-graph rendering format'
            cand --dry-run 'Preview what would run, without executing anything'
            cand --explain 'Preview what would run, with the reasoning for each unit'
            cand --fail-fast 'Stop scheduling after the first failure (when running tasks only)'
            cand --no-cache 'Execution verbs only: bypass the task cache (every unit re-runs; records are neither read nor written)'
            cand --refresh 'Execution verbs only: ignore cached results and re-run every unit, but still write the fresh results back (distinct from `--no-cache`, which neither reads nor writes). Mutually exclusive with `--no-cache`'
            cand --merge-base 'Change-selection commands only: diff against `merge-base(reference, HEAD)`'
            cand --dependents 'Execution/affected/explain verbs and bare tasks: with `--module`/ `--workspace`, also activate the reverse-dependents closure (everything that depends on the selection)'
            cand --dependencies 'Execution/affected/explain verbs and bare tasks: with `--module`/ `--workspace`, also activate the forward-dependencies closure (everything the selection needs)'
            cand --watch 'When running tasks only: keep running, re-executing the affected subgraph each time a watched source file changes (Ctrl+C exits)'
            cand -v 'Increase reporter verbosity (repeatable; execution verbs only)'
            cand --verbose 'Increase reporter verbosity (repeatable; execution verbs only)'
            cand -q 'Decrease reporter verbosity (repeatable; execution verbs only)'
            cand --quiet 'Decrease reporter verbosity (repeatable; execution verbs only)'
            cand --no-push 'Release only: skip pushing the release commit and tags'
            cand --offline 'Release bump/tag/publish only: skip registry `published_versions` lookups and anchor idempotency on the release tag only'
            cand --download 'Release verify only: download the declared assets from the hosted release and verify signature + checksum before extraction, instead of verifying the local `dist/` archives'
            cand --no-run 'Release verify only: skip executing the packaged binary; presence, signature, and checksum are still enforced'
            cand --non-interactive 'Init only: answer the wizard non-interactively, accepting every default'
            cand --yes 'Release bump/tag/publish/image only: confirm the real mutation. Kept separate from `--non-interactive` so authorizing a release is always a deliberate flag, never something learned as harmless on `init`'
            cand --print 'Init only: render the `toven.toml` to stdout and write nothing'
            cand --auto-install 'Driver/federation only: provision missing drivers automatically'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'toven;cache;help'= {
            cand stats 'Summarize the local cache directory'
            cand clean 'Remove the local cache directory'
            cand path 'Print the resolved local cache directory'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'toven;cache;help;stats'= {
        }
        &'toven;cache;help;clean'= {
        }
        &'toven;cache;help;path'= {
        }
        &'toven;cache;help;help'= {
        }
        &'toven;help'= {
            cand run 'Run a task by name (escape hatch for task names that shadow a reserved word)'
            cand plan 'Preview what a task would run, without executing it (`run <task> --dry-run`)'
            cand release 'Plan, inspect, and publish a release through its lifecycle actions'
            cand coverage 'Run the coverage task, aggregate the emitted profiles per module, and gate them against the resolved coverage thresholds'
            cand explain 'Explain what a task would run, optionally filtered to a `--module` selection'
            cand init 'Detect ecosystems and write (or preview) a `toven.toml` via the wizard'
            cand affected 'Project the affected-module set for a task'
            cand modules 'List discovered modules'
            cand graph 'Project the dependency graph (text or dot)'
            cand tasks 'List the runnable tasks resolved for each ecosystem'
            cand doctor 'Audit the tools the resolved task graph needs and report which are present or missing'
            cand commit-lint 'Lint a commit message (or PR title) against the Conventional Commits `type(scope)!: description` grammar Toven''s changelog relies on'
            cand completions 'Print a shell completion script (`bash`/`zsh`/`fish`/`powershell`/`elvish`)'
            cand driver 'Out-of-process driver management'
            cand federation 'Cross-repo federation management'
            cand cache 'Task-cache maintenance'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'toven;help;run'= {
        }
        &'toven;help;plan'= {
        }
        &'toven;help;release'= {
            cand plan 'Show the release plan — bumped versions, changelog, and publish order — without mutating anything'
            cand status 'Show each module''s declared version versus what is published and tagged (read-only)'
            cand tag 'Cut the release: bump manifests, commit, tag, and push — without publishing to the registry'
            cand bump 'Run only the version + changelog mutation phase: rewrite each module''s manifest version and dependency floors and, where configured, roll the changelog, then stage the mutation for a pull request. Never commits, tags, pushes, or publishes — the commit/tag/push is `release tag` / `release publish` after the staged change merges'
            cand publish 'Run the full release pipeline (commit, tag, push, publish); `--dry-run` rehearses the publish order and per-module would-publish/already-published verdicts without mutating anything'
            cand readiness 'Evaluate the fail-closed release-readiness preflight (configured go/no-go checks) without mutating anything'
            cand sbom 'Generate a CycloneDX SBOM per releasable module under `--out-dir` (read-only)'
            cand depgraphs 'Render the dependency graph to a DOT artifact under `--out-dir` (read-only)'
            cand package 'Package already-built binaries into the fixed-name archive assets the hosted release declares (`--target <triple>`); non-mutating'
            cand checksums 'Write the `SHA256SUMS` manifest over the declared release assets to its declared asset path; non-mutating'
            cand sign 'Sign the `SHA256SUMS` manifest into its declared self-contained Sigstore bundle asset with cosign; non-mutating'
            cand verify 'Verify the declared release archives — locally (presence + reported version) or, with `--download`, against the hosted release (signature + checksum + reported version); non-mutating'
            cand image 'Build the configured container image once, push it to the primary registry plus mirrors immutably, and cosign-sign the pushed digest; `--dry-run` previews the references and existing digests mutation-free, the real push requires `--yes`'
            cand provenance 'Verify that exactly the published subjects (declared `SHA256SUMS` entries plus pushed image digests) carry a build-provenance attestation cut by the CI trusted builder; `--dry-run` reports presence without failing, the default run fails closed if any subject lacks one'
        }
        &'toven;help;release;plan'= {
        }
        &'toven;help;release;status'= {
        }
        &'toven;help;release;tag'= {
        }
        &'toven;help;release;bump'= {
        }
        &'toven;help;release;publish'= {
        }
        &'toven;help;release;readiness'= {
        }
        &'toven;help;release;sbom'= {
        }
        &'toven;help;release;depgraphs'= {
        }
        &'toven;help;release;package'= {
        }
        &'toven;help;release;checksums'= {
        }
        &'toven;help;release;sign'= {
        }
        &'toven;help;release;verify'= {
        }
        &'toven;help;release;image'= {
        }
        &'toven;help;release;provenance'= {
        }
        &'toven;help;coverage'= {
        }
        &'toven;help;explain'= {
        }
        &'toven;help;init'= {
        }
        &'toven;help;affected'= {
        }
        &'toven;help;modules'= {
        }
        &'toven;help;graph'= {
        }
        &'toven;help;tasks'= {
        }
        &'toven;help;doctor'= {
        }
        &'toven;help;commit-lint'= {
        }
        &'toven;help;completions'= {
        }
        &'toven;help;driver'= {
            cand install 'Install an out-of-process driver by id'
            cand list 'List installed drivers'
        }
        &'toven;help;driver;install'= {
        }
        &'toven;help;driver;list'= {
        }
        &'toven;help;federation'= {
            cand sync 'Synchronize federated member repositories'
            cand status 'Report federation status'
        }
        &'toven;help;federation;sync'= {
        }
        &'toven;help;federation;status'= {
        }
        &'toven;help;cache'= {
            cand stats 'Summarize the local cache directory'
            cand clean 'Remove the local cache directory'
            cand path 'Print the resolved local cache directory'
        }
        &'toven;help;cache;stats'= {
        }
        &'toven;help;cache;clean'= {
        }
        &'toven;help;cache;path'= {
        }
        &'toven;help;help'= {
        }
    ]
    $completions[$command]
}
