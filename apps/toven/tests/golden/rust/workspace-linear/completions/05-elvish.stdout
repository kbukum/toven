            cand --minor 'Release bump/tag/publish only: force `<module>` to bump at the minor level (repeatable; valued form `--minor=<module>`). Given with no value, bumps every in-scope module at minor, each advancing from its own baseline (repo-wide)'
            cand --major 'Release bump/tag/publish only: force `<module>` to bump at the major level (repeatable; valued form `--major=<module>`). Given with no value, bumps every in-scope module at major, each advancing from its own baseline (repo-wide)'
            cand --set-version 'Release bump/tag/publish only: pin `<module>=<x.y.z>` to an explicit target version (repeatable), or a bare `<x.y.z>` to set every in-scope module to that version (lock-step, root included)'
            cand --pre 'Release bump/tag/publish only: cut a prerelease on a configured channel (`rc`/`alpha`/`beta`)'
            cand --out-dir 'Release sbom/depgraphs only: directory to write generated artifacts into (created if absent; defaults to `target/toven/release`)'
            cand --target 'Release package only: the target triple to package (e.g. `x86_64-unknown-linux-gnu`); selects the declared archive asset and the built binary under `target/<triple>/release/`'
            cand --binary 'Release package only: explicit path to the already-built binary to archive; defaults to `target/<triple>/release/<binary>`'
            cand --line 'Coverage only: override the absolute line-coverage floor for this run (percentage, `0..=100`); wins over the `[…coverage].line` config default'
            cand --function 'Coverage only: override the function-coverage floor for this run (percentage; gated only where the ecosystem measures functions)'
            cand --region 'Coverage only: override the region-coverage floor for this run (percentage; gated only where the ecosystem measures regions)'
            cand --changed-line 'Coverage only: override the changed-lines floor for this run (percentage; applied to changed files under a changed selection)'
            cand --enforcement 'Coverage only: override how a below-threshold verdict is enforced (`block` fails the gate; `advisory` reports without failing)'
            cand --force 'Init only: regenerate one `[ecosystems.<id>]` section'
            cand --root 'Init only: project root to onboard against'
            cand --format 'Graph only: dependency-graph rendering format'
            cand --dry-run 'Preview what would run, without executing anything'
            cand --explain 'Preview what would run, with the reasoning for each unit'
            cand --fail-fast 'Stop scheduling after the first failure (when running tasks only)'
            cand --no-cache 'Execution verbs only: bypass the task cache (every unit re-runs; records are neither read nor written)'
            cand --refresh 'Execution verbs only: ignore cached results and re-run every unit, but still write the fresh results back (distinct from `--no-cache`, which neither reads nor writes). Mutually exclusive with `--no-cache`'
            cand --merge-base 'Change-selection commands only: diff against `merge-base(reference, HEAD)`'
            cand --dependents 'Execution/affected/explain verbs and bare tasks: with `--module`/ `--workspace`, also activate the reverse-dependents closure (everything that depends on the selection)'
            cand --dependencies 'Execution/affected/explain verbs and bare tasks: with `--module`/ `--workspace`, also activate the forward-dependencies closure (everything the selection needs)'
            cand --watch 'When running tasks only: keep running, re-executing the affected subgraph each time a watched source file changes (Ctrl+C exits)'
            cand -v 'Increase reporter verbosity (repeatable; execution verbs only)'
            cand --verbose 'Increase reporter verbosity (repeatable; execution verbs only)'
            cand -q 'Decrease reporter verbosity (repeatable; execution verbs only)'
            cand --quiet 'Decrease reporter verbosity (repeatable; execution verbs only)'
            cand --no-push 'Release only: skip pushing the release commit and tags'
            cand --offline 'Release bump/tag/publish only: skip registry `published_versions` lookups and anchor idempotency on the release tag only'
            cand --download 'Release verify only: download the declared assets from the hosted release and verify signature + checksum before extraction, instead of verifying the local `dist/` archives'
            cand --no-run 'Release verify only: skip executing the packaged binary; presence, signature, and checksum are still enforced'
            cand --non-interactive 'Init only: answer the wizard non-interactively, accepting every default'
            cand --yes 'Release bump/tag/publish/image only: confirm the real mutation. Kept separate from `--non-interactive` so authorizing a release is always a deliberate flag, never something learned as harmless on `init`'
            cand --print 'Init only: render the `toven.toml` to stdout and write nothing'
            cand --auto-install 'Driver/federation only: provision missing drivers automatically'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
        }
        &'toven;plan'= {
            cand --config 'Path to the `toven.toml` config (otherwise discovered upward from the cwd)'
            cand --output 'Output format: `human` tables or machine-readable `jsonl` (defaults to the `[toven].report` setting)'
            cand --color 'When to colorize human output: `auto` (default), `always`, or `never`. `NO_COLOR` always wins over `always`. Accepted on every command; commands that produce no colorized output simply ignore it'
