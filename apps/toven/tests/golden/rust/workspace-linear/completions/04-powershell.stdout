            [CompletionResult]::new('-v', '-v', [CompletionResultType]::ParameterName, 'Increase reporter verbosity (repeatable; execution verbs only)')
            [CompletionResult]::new('--verbose', '--verbose', [CompletionResultType]::ParameterName, 'Increase reporter verbosity (repeatable; execution verbs only)')
            [CompletionResult]::new('-q', '-q', [CompletionResultType]::ParameterName, 'Decrease reporter verbosity (repeatable; execution verbs only)')
            [CompletionResult]::new('--quiet', '--quiet', [CompletionResultType]::ParameterName, 'Decrease reporter verbosity (repeatable; execution verbs only)')
