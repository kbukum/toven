            [CompletionResult]::new('--major', '--major', [CompletionResultType]::ParameterName, 'Release tag/publish only: force `<module>` to bump at the major level (repeatable)')
            [CompletionResult]::new('--set-version', '--set-version', [CompletionResultType]::ParameterName, 'Release tag/publish only: pin `<module>=<x.y.z>` to an explicit target version (repeatable)')
            [CompletionResult]::new('--pre', '--pre', [CompletionResultType]::ParameterName, 'Release tag/publish only: cut a prerelease on a configured channel (`rc`/`alpha`/`beta`)')
            [CompletionResult]::new('--out-dir', '--out-dir', [CompletionResultType]::ParameterName, 'Release sbom/depgraphs only: directory to write generated artifacts into (created if absent; defaults to `target/toven/release`)')
            [CompletionResult]::new('--target', '--target', [CompletionResultType]::ParameterName, 'Release package only: the target triple to package (e.g. `x86_64-unknown-linux-gnu`); selects the declared archive asset and the built binary under `target/<triple>/release/`')
            [CompletionResult]::new('--binary', '--binary', [CompletionResultType]::ParameterName, 'Release package only: explicit path to the already-built binary to archive; defaults to `target/<triple>/release/<binary>`')
            [CompletionResult]::new('--line', '--line', [CompletionResultType]::ParameterName, 'Coverage only: override the absolute line-coverage floor for this run (percentage, `0..=100`); wins over the `[…coverage].line` config default')
            [CompletionResult]::new('--function', '--function', [CompletionResultType]::ParameterName, 'Coverage only: override the function-coverage floor for this run (percentage; gated only where the ecosystem measures functions)')
            [CompletionResult]::new('--region', '--region', [CompletionResultType]::ParameterName, 'Coverage only: override the region-coverage floor for this run (percentage; gated only where the ecosystem measures regions)')
            [CompletionResult]::new('--changed-line', '--changed-line', [CompletionResultType]::ParameterName, 'Coverage only: override the changed-lines floor for this run (percentage; applied to changed files under a changed selection)')
            [CompletionResult]::new('--enforcement', '--enforcement', [CompletionResultType]::ParameterName, 'Coverage only: override how a below-threshold verdict is enforced (`block` fails the gate; `advisory` reports without failing)')
            [CompletionResult]::new('--force', '--force', [CompletionResultType]::ParameterName, 'Init only: regenerate one `[ecosystems.<id>]` section')
            [CompletionResult]::new('--root', '--root', [CompletionResultType]::ParameterName, 'Init only: project root to onboard against')
            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Graph only: dependency-graph rendering format')
            [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Preview what would run, without executing anything')
            [CompletionResult]::new('--explain', '--explain', [CompletionResultType]::ParameterName, 'Preview what would run, with the reasoning for each unit')
            [CompletionResult]::new('--fail-fast', '--fail-fast', [CompletionResultType]::ParameterName, 'Stop scheduling after the first failure (when running tasks only)')
            [CompletionResult]::new('--no-cache', '--no-cache', [CompletionResultType]::ParameterName, 'Execution verbs only: bypass the task cache (every unit re-runs; records are neither read nor written)')
            [CompletionResult]::new('--refresh', '--refresh', [CompletionResultType]::ParameterName, 'Execution verbs only: ignore cached results and re-run every unit, but still write the fresh results back (distinct from `--no-cache`, which neither reads nor writes). Mutually exclusive with `--no-cache`')
            [CompletionResult]::new('--merge-base', '--merge-base', [CompletionResultType]::ParameterName, 'Change-selection commands only: diff against `merge-base(reference, HEAD)`')
            [CompletionResult]::new('--dependents', '--dependents', [CompletionResultType]::ParameterName, 'Execution/affected/explain verbs and bare tasks: with `--module`/ `--workspace`, also activate the reverse-dependents closure (everything that depends on the selection)')
            [CompletionResult]::new('--dependencies', '--dependencies', [CompletionResultType]::ParameterName, 'Execution/affected/explain verbs and bare tasks: with `--module`/ `--workspace`, also activate the forward-dependencies closure (everything the selection needs)')
            [CompletionResult]::new('--watch', '--watch', [CompletionResultType]::ParameterName, 'When running tasks only: keep running, re-executing the affected subgraph each time a watched source file changes (Ctrl+C exits)')
            [CompletionResult]::new('-v', '-v', [CompletionResultType]::ParameterName, 'Increase reporter verbosity (repeatable; execution verbs only)')
            [CompletionResult]::new('--verbose', '--verbose', [CompletionResultType]::ParameterName, 'Increase reporter verbosity (repeatable; execution verbs only)')
            [CompletionResult]::new('-q', '-q', [CompletionResultType]::ParameterName, 'Decrease reporter verbosity (repeatable; execution verbs only)')
            [CompletionResult]::new('--quiet', '--quiet', [CompletionResultType]::ParameterName, 'Decrease reporter verbosity (repeatable; execution verbs only)')
            [CompletionResult]::new('--no-push', '--no-push', [CompletionResultType]::ParameterName, 'Release only: skip pushing the release commit and tags')
            [CompletionResult]::new('--no-commit', '--no-commit', [CompletionResultType]::ParameterName, 'Release bump only: stage the version/changelog mutation for a pull request instead of creating the release commit')
            [CompletionResult]::new('--offline', '--offline', [CompletionResultType]::ParameterName, 'Release tag/publish only: skip registry `published_versions` lookups and anchor idempotency on the release tag only')
            [CompletionResult]::new('--download', '--download', [CompletionResultType]::ParameterName, 'Release verify only: download the declared assets from the hosted release and verify signature + checksum before extraction, instead of verifying the local `dist/` archives')
            [CompletionResult]::new('--no-run', '--no-run', [CompletionResultType]::ParameterName, 'Release verify only: skip executing the packaged binary; presence, signature, and checksum are still enforced')
            [CompletionResult]::new('--non-interactive', '--non-interactive', [CompletionResultType]::ParameterName, 'Init only: answer the wizard non-interactively, accepting every default')
            [CompletionResult]::new('--yes', '--yes', [CompletionResultType]::ParameterName, 'Release tag/publish only: confirm the real mutation. Kept separate from `--non-interactive` so authorizing a release is always a deliberate flag, never something learned as harmless on `init`')
            [CompletionResult]::new('--print', '--print', [CompletionResultType]::ParameterName, 'Init only: render the `toven.toml` to stdout and write nothing')
            [CompletionResult]::new('--auto-install', '--auto-install', [CompletionResultType]::ParameterName, 'Driver/federation only: provision missing drivers automatically')
            [CompletionResult]::new('-h', '-h', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            [CompletionResult]::new('--help', '--help', [CompletionResultType]::ParameterName, 'Print help (see more with ''--help'')')
            break
        }
        'toven;cache;help' {
            [CompletionResult]::new('stats', 'stats', [CompletionResultType]::ParameterValue, 'Summarize the local cache directory')
            [CompletionResult]::new('clean', 'clean', [CompletionResultType]::ParameterValue, 'Remove the local cache directory')
            [CompletionResult]::new('path', 'path', [CompletionResultType]::ParameterValue, 'Print the resolved local cache directory')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'toven;cache;help;stats' {
            break
        }
        'toven;cache;help;clean' {
            break
        }
        'toven;cache;help;path' {
            break
        }
        'toven;cache;help;help' {
            break
        }
        'toven;help' {
            [CompletionResult]::new('run', 'run', [CompletionResultType]::ParameterValue, 'Run a task by name (escape hatch for task names that shadow a reserved word)')
            [CompletionResult]::new('plan', 'plan', [CompletionResultType]::ParameterValue, 'Preview what a task would run, without executing it (`run <task> --dry-run`)')
            [CompletionResult]::new('release', 'release', [CompletionResultType]::ParameterValue, 'Plan, inspect, and publish a release through its lifecycle actions')
            [CompletionResult]::new('coverage', 'coverage', [CompletionResultType]::ParameterValue, 'Run the coverage task, aggregate the emitted profiles per module, and gate them against the resolved coverage thresholds')
            [CompletionResult]::new('explain', 'explain', [CompletionResultType]::ParameterValue, 'Explain what a task would run, optionally filtered to a `--module` selection')
            [CompletionResult]::new('init', 'init', [CompletionResultType]::ParameterValue, 'Detect ecosystems and write (or preview) a `toven.toml` via the wizard')
            [CompletionResult]::new('affected', 'affected', [CompletionResultType]::ParameterValue, 'Project the affected-module set for a task')
            [CompletionResult]::new('modules', 'modules', [CompletionResultType]::ParameterValue, 'List discovered modules')
            [CompletionResult]::new('graph', 'graph', [CompletionResultType]::ParameterValue, 'Project the dependency graph (text or dot)')
            [CompletionResult]::new('tasks', 'tasks', [CompletionResultType]::ParameterValue, 'List the runnable tasks resolved for each ecosystem')
            [CompletionResult]::new('doctor', 'doctor', [CompletionResultType]::ParameterValue, 'Audit the tools the resolved task graph needs and report which are present or missing')
            [CompletionResult]::new('completions', 'completions', [CompletionResultType]::ParameterValue, 'Print a shell completion script (`bash`/`zsh`/`fish`/`powershell`/`elvish`)')
            [CompletionResult]::new('driver', 'driver', [CompletionResultType]::ParameterValue, 'Out-of-process driver management')
            [CompletionResult]::new('federation', 'federation', [CompletionResultType]::ParameterValue, 'Cross-repo federation management')
            [CompletionResult]::new('cache', 'cache', [CompletionResultType]::ParameterValue, 'Task-cache maintenance')
            [CompletionResult]::new('help', 'help', [CompletionResultType]::ParameterValue, 'Print this message or the help of the given subcommand(s)')
            break
        }
        'toven;help;run' {
            break
        }
        'toven;help;plan' {
            break
        }
        'toven;help;release' {
            [CompletionResult]::new('plan', 'plan', [CompletionResultType]::ParameterValue, 'Show the release plan — bumped versions, changelog, and publish order — without mutating anything')
            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'Show each module''s declared version versus what is published and tagged (read-only)')
            [CompletionResult]::new('tag', 'tag', [CompletionResultType]::ParameterValue, 'Cut the release: bump manifests, commit, tag, and push — without publishing to the registry')
            [CompletionResult]::new('bump', 'bump', [CompletionResultType]::ParameterValue, 'Run only the version + changelog mutation phase: rewrite each module''s manifest version and dependency floors and, where configured, roll the changelog, then commit the release (or, with `--no-commit`, stage it for a pull request). Never tags, pushes, or publishes')
            [CompletionResult]::new('publish', 'publish', [CompletionResultType]::ParameterValue, 'Run the full release pipeline (commit, tag, push, publish); `--dry-run` rehearses the publish order and per-module would-publish/already-published verdicts without mutating anything')
            [CompletionResult]::new('readiness', 'readiness', [CompletionResultType]::ParameterValue, 'Evaluate the fail-closed release-readiness preflight (configured go/no-go checks) without mutating anything')
            [CompletionResult]::new('sbom', 'sbom', [CompletionResultType]::ParameterValue, 'Generate a CycloneDX SBOM per releasable module under `--out-dir` (read-only)')
            [CompletionResult]::new('depgraphs', 'depgraphs', [CompletionResultType]::ParameterValue, 'Render the dependency graph to a DOT artifact under `--out-dir` (read-only)')
            [CompletionResult]::new('package', 'package', [CompletionResultType]::ParameterValue, 'Package already-built binaries into the fixed-name archive assets the hosted release declares (`--target <triple>`); non-mutating')
            [CompletionResult]::new('checksums', 'checksums', [CompletionResultType]::ParameterValue, 'Write the `SHA256SUMS` manifest over the declared release assets to its declared asset path; non-mutating')
            [CompletionResult]::new('sign', 'sign', [CompletionResultType]::ParameterValue, 'Sign the `SHA256SUMS` manifest into its declared detached-signature and certificate sidecar assets with cosign; non-mutating')
            [CompletionResult]::new('verify', 'verify', [CompletionResultType]::ParameterValue, 'Verify the declared release archives — locally (presence + reported version) or, with `--download`, against the hosted release (signature + checksum + reported version); non-mutating')
            [CompletionResult]::new('image', 'image', [CompletionResultType]::ParameterValue, 'Build the configured container image once, push it to the primary registry plus mirrors immutably, and cosign-sign the pushed digest; `--dry-run` previews the references and existing digests mutation-free, the real push requires `--yes`')
            [CompletionResult]::new('provenance', 'provenance', [CompletionResultType]::ParameterValue, 'Verify that exactly the published subjects (declared `SHA256SUMS` entries plus pushed image digests) carry a build-provenance attestation cut by the CI trusted builder; `--dry-run` reports presence without failing, the default run fails closed if any subject lacks one')
            break
        }
        'toven;help;release;plan' {
            break
        }
        'toven;help;release;status' {
            break
        }
        'toven;help;release;tag' {
            break
        }
        'toven;help;release;bump' {
            break
        }
        'toven;help;release;publish' {
            break
        }
        'toven;help;release;readiness' {
            break
        }
        'toven;help;release;sbom' {
            break
        }
        'toven;help;release;depgraphs' {
            break
        }
        'toven;help;release;package' {
            break
        }
        'toven;help;release;checksums' {
            break
        }
        'toven;help;release;sign' {
            break
        }
        'toven;help;release;verify' {
            break
        }
        'toven;help;release;image' {
            break
        }
        'toven;help;release;provenance' {
            break
        }
        'toven;help;coverage' {
            break
        }
        'toven;help;explain' {
            break
        }
        'toven;help;init' {
            break
        }
        'toven;help;affected' {
            break
        }
        'toven;help;modules' {
            break
        }
        'toven;help;graph' {
            break
        }
        'toven;help;tasks' {
            break
        }
        'toven;help;doctor' {
            break
        }
        'toven;help;completions' {
            break
        }
        'toven;help;driver' {
            [CompletionResult]::new('install', 'install', [CompletionResultType]::ParameterValue, 'Install an out-of-process driver by id')
            [CompletionResult]::new('list', 'list', [CompletionResultType]::ParameterValue, 'List installed drivers')
            break
        }
        'toven;help;driver;install' {
            break
        }
        'toven;help;driver;list' {
            break
        }
        'toven;help;federation' {
            [CompletionResult]::new('sync', 'sync', [CompletionResultType]::ParameterValue, 'Synchronize federated member repositories')
            [CompletionResult]::new('status', 'status', [CompletionResultType]::ParameterValue, 'Report federation status')
            break
        }
        'toven;help;federation;sync' {
            break
        }
        'toven;help;federation;status' {
            break
        }
        'toven;help;cache' {
            [CompletionResult]::new('stats', 'stats', [CompletionResultType]::ParameterValue, 'Summarize the local cache directory')
            [CompletionResult]::new('clean', 'clean', [CompletionResultType]::ParameterValue, 'Remove the local cache directory')
            [CompletionResult]::new('path', 'path', [CompletionResultType]::ParameterValue, 'Print the resolved local cache directory')
            break
        }
        'toven;help;cache;stats' {
            break
        }
        'toven;help;cache;clean' {
            break
        }
        'toven;help;cache;path' {
            break
        }
        'toven;help;help' {
            break
        }
    })

    $completions.Where{ $_.CompletionText -like "$wordToComplete*" } |
        Sort-Object -Property ListItemText
}
