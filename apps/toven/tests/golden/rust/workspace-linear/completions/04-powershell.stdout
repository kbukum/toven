            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterName, 'Graph only: dependency-graph rendering format')
            [CompletionResult]::new('--dry-run', '--dry-run', [CompletionResultType]::ParameterName, 'Preview what would run, without executing anything')
            [CompletionResult]::new('--explain', '--explain', [CompletionResultType]::ParameterName, 'Preview what would run, with the reasoning for each unit')
