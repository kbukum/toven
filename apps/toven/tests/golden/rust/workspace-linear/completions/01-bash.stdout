    case "${cmd}" in
        toven)
            opts="-j -v -q -h -V --config --output --color --view --dry-run --explain --fail-fast --no-cache --refresh --timeout --jobs --base --merge-base --module --workspace --dependents --dependencies --watch --watch-debounce-ms --verbose --quiet --no-push --patch --minor --major --set-version --pre --offline --out-dir --target --binary --download --no-run --line --function --region --changed-line --enforcement --force --root --non-interactive --yes --print --format --auto-install --help --version run plan release coverage explain init affected modules list ls graph deps tasks doctor commit-lint completions driver federation cache help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --config)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
                    ;;
                --output)
                    COMPREPLY=($(compgen -W "human jsonl" -- "${cur}"))
