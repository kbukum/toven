# Rust build artifacts — any depth (covers workspace root, fuzz/, benches/, etc.)
target/
dist/
# Isolated/auxiliary build dirs (e.g. per-run coverage target dirs like target-cov*)
target-*/
**/*.rs.bk
*.pdb

# Fuzz sub-workspace (excluded from main workspace; its lockfile is not reproducibility-critical)
fuzz/Cargo.lock
# Fuzzing artifacts (regenerated by cargo-fuzz; not source)
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/

# Coverage
coverage.lcov
lcov.info
*.profraw
*.profdata
tarpaulin-report.html
tarpaulin-report.json
cobertura.xml

# Python tooling artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Benchmarks
criterion/

# IDE
.idea/
*.swp
*.swo
*~

# Environment
.env
.env.local
.secrets

# OS
.DS_Store
Thumbs.db

/tmp/*
!/tmp/.keep

# Scratch release publication output (release.yml writes these to the repo root
# and uploads them as CI artifacts; they are never committed, and must stay
# ignored so the publish job's clean-worktree guard does not count them).
/release-preview.jsonl
/release-publish.jsonl

# Editor-local settings
/.vscode/
# Stray CycloneDX SBOMs if a release-sbom run is interrupted before files move to target/sbom/
*.cdx.json
