{
  "name": "acme-smoke",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "acme-smoke",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@acme/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@acme/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/app": {
      "name": "@acme/app",
      "version": "1.0.0",
      "dependencies": {
        "@acme/core": "*"
      }
    },
    "packages/core": {
      "name": "@acme/core",
      "version": "1.0.0"
    }
  }
}
