class Toven < Formula
  desc "Argv-first development and CI task planner for multi-module repositories"
  homepage "https://github.com/kbukum/toven"
  version "__VERSION__"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/kbukum/toven/releases/download/v__VERSION__/toven-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA_AARCH64_APPLE_DARWIN__"
    end
    on_intel do
      url "https://github.com/kbukum/toven/releases/download/v__VERSION__/toven-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA_X86_64_APPLE_DARWIN__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/kbukum/toven/releases/download/v__VERSION__/toven-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_AARCH64_UNKNOWN_LINUX_GNU__"
    end
    on_intel do
      url "https://github.com/kbukum/toven/releases/download/v__VERSION__/toven-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_X86_64_UNKNOWN_LINUX_GNU__"
    end
  end

  def install
    bin.install "toven"
  end

  test do
    assert_match "toven", shell_output("#{bin}/toven --version")
  end
end
